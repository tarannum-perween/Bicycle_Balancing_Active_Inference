<?xml version="1.0"?>
<xacro:macro name="cmg_gazebo" xmlns:xacro="http://ros.org"> 

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/cmg_device</robotNamespace>
    </plugin>
  </gazebo>
  
  <gazebo reference= "torque_servo" >
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference= "flywheel_servo" >
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference= "flywheel_disk1" >
    <visual>
      <material>
        <ambient>0.5 0.0 0.0 1.0</ambient>
        <diffuse>1.0 0.1 0.1 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference= "flywheel_annulus" >
    <visual>
      <material>
        <ambient>0.5 0.0 0.0 1.0</ambient>
        <diffuse>1.0 0.1 0.1 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <!-- Path to the controller YAML config file -->
      <parameters>$(find cmgdevice_description)/config/roll_torque_servo_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Gazebo (classic) Torque servo control model -->
  <transmission name="servo_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="roll_moment_servo_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="roll_moment_servo">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

<!-- Activating and Driving the Joint: a. Launch built-in controller manager nodes -->
<!--ros2 run controller_manager spawner joint_state_broadcaster -->
<!--ros2 run controller_manager spawner servo_torque_controller -->

<!-- Read States and Publish Torques -->

<!-- command line example to publish torque value = 0.75 Nm (note standard msg data type): -->
<!-- ros2 topic pub /servo_torque_controller/commands std_msgs/msg/Float64MultiArray "{data: [0.75]}" -->

</xacro:macro>